# ── Copy to .env.local — NEVER commit this file ──────────────────

# PostgreSQL (get free DB at neon.tech)
DATABASE_URL="postgresql://USER:PASS@HOST:5432/aranyaghosh?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/aranyaghosh?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# GitHub API (5000 req/hr with token vs 60 without)
GITHUB_TOKEN="ghp_your_personal_access_token"

# Cloudinary (photo uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email notifications (Resend — 3000 free/month)
RESEND_API_KEY="re_your_key"

# Site URL
NEXT_PUBLIC_SITE_URL="https://aranyaghosh.org"

# Vercel (for GitHub Actions CI/CD)
VERCEL_TOKEN="your_vercel_token"
VERCEL_ORG_ID="your_org_id"
VERCEL_PROJECT_ID="your_project_id"
