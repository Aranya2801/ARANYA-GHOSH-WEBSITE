# All optional — the site builds and runs without any of them.
NEXT_PUBLIC_SITE_URL=https://aranyaghosh.org

# Contact form delivery (either or both; with neither, the form answers 503)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Store contact messages in Postgres (e.g. Neon). Table is created automatically.
DATABASE_URL=

# Raises the GitHub API rate limit for the live stats section
GITHUB_TOKEN=
