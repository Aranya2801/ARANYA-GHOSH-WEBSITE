// Aranya Ghosh Website — Database Schema
// Run: npx prisma db push
// Studio: npx prisma studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Blog Posts ──────────────────────────────────────────────────
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text
  tags        String[]
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  readTime    Int      @default(5)
  views       Int      @default(0)
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published, createdAt])
}

// ── Vlog / Journal Entries ──────────────────────────────────────
model VlogEntry {
  id        String   @id @default(cuid())
  date      String
  title     String
  body      String?  @db.Text
  mood      String?
  tags      String[]
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ── Projects (CMS-driven) ───────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  num         String
  badge       String?
  title       String
  description String   @db.Text
  tags        String[]
  github      String?
  demo        String?
  image       String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

// ── Contact Messages ────────────────────────────────────────────
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// ── Favourite Songs ─────────────────────────────────────────────
model FavSong {
  id        String   @id @default(cuid())
  num       String
  title     String
  artist    String
  spotifyId String?
  albumArt  String?
  order     Int      @default(0)
}

// ── Favourite Movies ────────────────────────────────────────────
model FavMovie {
  id        String   @id @default(cuid())
  rank      String
  title     String
  genre     String
  year      String?
  poster    String?
  order     Int      @default(0)
}

// ── Page Views Analytics ────────────────────────────────────────
model PageView {
  id        String   @id @default(cuid())
  page      String
  referrer  String?
  country   String?
  createdAt DateTime @default(now())

  @@index([page, createdAt])
}
